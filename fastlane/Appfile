# Store identifiers for Rotor: Daily Lock. Credentials come from the environment
# (see docs/RELEASE.md); nothing secret belongs in this file.

for_platform :ios do
  app_identifier("com.behtoyi.rotor")
end

for_platform :android do
  package_name("com.behtoyi.rotor")
  json_key_file(ENV["GOOGLE_SERVICE_ACCOUNT_KEY_PATH"]) if ENV["GOOGLE_SERVICE_ACCOUNT_KEY_PATH"].to_s != ""
end
